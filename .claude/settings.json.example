{
  "worktree": { "bgIsolation": "none" },
  "permissions": {
    "allow": ["mcp__outside-in-tdd", "mcp__project-mcp"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__outside-in-tdd__init_feature|mcp__outside-in-tdd__drill_down",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.agents/hooks/project-mcp-consult-gate.sh\" check"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__project-mcp__find_symbol|mcp__project-mcp__get_symbol_context|mcp__project-mcp__get_dependencies|mcp__project-mcp__get_dependents|mcp__project-mcp__get_project_overview",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.agents/hooks/project-mcp-consult-gate.sh\" mark"
          }
        ]
      }
    ]
  }
}
