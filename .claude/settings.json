{
  "worktree": { "bgIsolation": "none" },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.agents/hooks/block-direct-test-runs.sh\""
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.agents/hooks/danger-guard.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.agents/hooks/protect-sensitive-files.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__outside-in-tdd__init_feature|mcp__outside-in-tdd__drill_down|mcp__outside-in-tdd__write_test|mcp__outside-in-tdd__write_test_skeleton|mcp__outside-in-tdd__write_code",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.agents/hooks/project-mcp-reminder.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__project-mcp__find_symbol|mcp__project-mcp__get_symbol_context|mcp__project-mcp__get_dependencies|mcp__project-mcp__get_dependents|mcp__project-mcp__get_project_overview",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.agents/hooks/project-mcp-mark-consulted.sh\""
          }
        ]
      }
    ]
  }
}
